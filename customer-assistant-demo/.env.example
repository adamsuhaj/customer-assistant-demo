# Step 0 - Template for local model and identity settings.
# - DEMO_MODEL_PROVIDER and model names select the gateway route without code edits.
# - The Streamlit Provider selection uses the matching key for live answers.
# - The notebook's default offline Run All needs neither key.
# - A signing secret lets private MCP tools verify application-minted identity.
# - Copy this file to .env for local values; never commit the populated copy.
DEMO_MODEL_PROVIDER=openai
DEMO_OPENAI_MODEL=openai/gpt-6-sol
DEMO_ANTHROPIC_MODEL=anthropic/claude-sonnet-5
DEMO_MODEL_TIMEOUT_SECONDS=30
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEMO_SIGNING_SECRET=
